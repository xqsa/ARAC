      "arac_action": "native_eq8",
      "group_optimizer_mode": "full_cmaes",
      "enable_relation_dispatch": false,
      "relation_policy": "controller_v31",
      "runtime_probe_repair_mode": "hard_repair",
      "evidence_overlay_mode": "off"
    },
    "arm_b": {
      "label": "diagonal_covariance",
      "action_surface": "group_optimizer_type",
      "arac_action": "native_eq8",
      "group_optimizer_mode": "diagonal_covariance",
      "enable_relation_dispatch": false,
      "relation_policy": "controller_v31",
      "runtime_probe_repair_mode": "hard_repair",
      "evidence_overlay_mode": "off"
    }
  },
  "analysis": {
    "pairing": "same case and seed across both arms",
    "primary_metric": "final_best_so_far_error",
