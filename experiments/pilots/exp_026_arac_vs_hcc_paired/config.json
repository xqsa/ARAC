  "purpose": "validate_diagonal_covariance_action_against_native_hcc",
  "description": "Paired same-case, same-seed, same-FE validation of one frozen group-optimizer action. No evidence selector, bandit, relation dispatch, or runtime probe is enabled.",
  "execution": {
    "cases": ["E1", "E3", "A4", "R4", "S5"],
    "seeds": [117, 118, 119, 120, 121],
    "max_fes": 300000,
    "jobs": 5,
    "budget_accounting": "strict",
    "search_state_backend": "phase_i_mmes",
    "cmaes_restart": true,
    "mmes_restart": true,
    "skip_plots": true,
    "arm_a": {
      "label": "native_full_cmaes",
